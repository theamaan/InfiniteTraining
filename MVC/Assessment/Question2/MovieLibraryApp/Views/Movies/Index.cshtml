@model IEnumerable<MovieLibraryApp.Models.Movie>

@{
    ViewBag.Title = "Movies List";
}

<h2>Movies List</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Director</th>
            <th>Release Date</th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var movie in Model)
        {
            <tr>
                <td>@movie.Id</td>
                <td>@movie.Title</td>
                <td>@movie.Director</td>
                <td>@movie.ReleaseDate.ToShortDateString()</td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = movie.Id })
                </td>
                <td>
                    @Html.ActionLink("Delete", "Delete", new { id = movie.Id })
                </td>
            </tr>
        }
    </tbody>
</table>
