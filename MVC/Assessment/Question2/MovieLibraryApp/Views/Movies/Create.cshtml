@model MovieLibraryApp.Models.Movie

@{
    ViewBag.Title = "Create";
}

<h2>Create</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Movie</h4>
        <hr />
        @Html.ValidationSummary(true)

        <div class="form-group">
            @Html.LabelFor(m => m.Title, new { @class = "control-label" })
            <div class="col-md-10">
                @Html.EditorFor(m => m.Title)
                @Html.ValidationMessageFor(m => m.Title)
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Director, new { @class = "control-label" })
            <div class="col-md-10">
                @Html.EditorFor(m => m.Director)
                @Html.ValidationMessageFor(m => m.Director)
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.ReleaseDate, new { @class = "control-label" })
            <div class="col-md-10">
                @Html.EditorFor(m => m.ReleaseDate)
                @Html.ValidationMessageFor(m => m.ReleaseDate)
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-10">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </div>
    </div>
}
